#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <key_rgb.dtsi>
#include <corne_controller_led.dtsi>
#include <pomodoro.dtsi>
#include <pomodoro_commands.h>

/* Per half: 6 underglow LEDs followed by 21 switch LEDs. */
&led_strip {
        chain-length = <27>;
};

/ {
        combos {
                compatible = "zmk,combos";

                combo_jlk_enter {
                        timeout-ms = <50>;
                        key-positions = <19 20 21>; /* J K L */
                        bindings = <&kp RET>;
                        layers = <0>;
                };
                combo_lk_backspace {
                        timeout-ms = <50>;
                        key-positions = <20 21>; /* K L */
                        bindings = <&kp BSPC>;
                        layers = <0>;
                };
                combo_sfd_escape {
                        timeout-ms = <50>;
                        key-positions = <14 15 16>; /* S D F */
                        bindings = <&kp ESC>;
                        layers = <0>;
                };
                combo_p_backspace_delete {
                        timeout-ms = <50>;
                        key-positions = <10 11>; /* P + Backspace */
                        bindings = <&kp DEL>;
                        layers = <0>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                lighting { if-layers = <1 2>; then-layer = <3>; };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        // Base
                        // | Tab  |  Q   |  W   |  E   |  R   |  T   ||  Y   |  U   |  I   |  O   |  P   | Bksp |
                        // | Ctrl |  A   |  S   |  D   |  F   |  G   ||  H   |  J   |  K   |  L   |  ;   |  '   |
                        // |Shift |  Z   |  X   |  C   |  V   |  B   ||  N   |  M   |  ,   |  .   |  /   | Esc  |
                        //                      | GUI  |Lower |Space ||Space |Raise | RAlt |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE &kp SPACE &mo 2 &kp RALT
                        >;
                };
                lower_layer {
                        // Lower (left middle thumb, DE)
                        // . = transparent; blank = disabled; Play = play/pause
                        // | Tab  |  1   |  2   |  3   |  4   |  5   ||  6   |  7   |  8   |  9   |  0   |  ü   |
                        // |BT clr| BT1  | BT2  | BT3  | BT4  | BT5  ||  .   |  .   |  Up  |  .   |  ö   |  ä   |
                        // |Shift | Vol+ | Vol- | Play | Next | Prev ||  .   | Left | Down |Right |      |      |
                        //                      | GUI  |  .   |Space ||Space |  .   | RAlt |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8   &kp N9     &kp N0   &kp LBKT
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans   &trans   &kp UP   &trans     &kp SEMI &kp SQT
   &kp LSHFT  &kp C_VOL_UP &kp C_VOL_DN &kp C_PP    &kp C_NEXT  &kp C_PREV     &trans   &kp LEFT &kp DOWN &kp RIGHT  &none    &none
                                    &kp LGUI     &trans       &kp SPACE    &kp SPACE  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        // Raise (right middle thumb, DE)
                        // . = transparent; blank = disabled
                        // | Tab  |  !   |  "   |  #   |  $   |  %   ||  ^   |  /   |  *   |      |      | Bksp |
                        // | Ctrl |  (   |  [   |  {   |  .   |  .   ||  -   |  =   |  }   |  ]   |  )   |  `   |
                        // |Shift |  .   |  .   |  .   |  .   |  .   ||  _   |  +   |      |      |      |  ~   |
                        //                      | GUI  |  .   |Space ||Space |  .   | RAlt |
                        bindings = <
   &kp TAB   &kp LS(N1) &kp LS(N2) &kp NUHS   &kp LS(N4) &kp LS(N5)   &kp GRAVE    &kp LS(N7) &kp LS(RBKT) &none      &none      &kp BSPC
   &kp LCTRL &kp LS(N8) &kp RA(N8) &kp RA(N7) &trans     &trans       &kp FSLH     &kp LS(N0) &kp RA(N0)   &kp RA(N9) &kp LS(N9) &kp LS(EQUAL)
   &kp LSHFT &trans     &trans     &trans     &trans     &trans       &kp LS(FSLH) &kp RBKT   &none        &none      &none      &kp RA(RBKT)
                             &kp LGUI &trans   &kp SPACE &kp SPACE   &trans    &kp RALT
                        >;
                };

                lighting_layer {
                        // Lighting (hold Lower + Raise)
                        // . = transparent; RGB = on/off; KeyLED = key LEDs; Pomo = start/stop
                        // Reset = restart focus; Phase = choose focus/break; -/+ = set duration
                        // |  .   |Color<|Color>|Effect| RGB  |KeyLED||  .   |  .   |  .   | Pomo |Reset |  .   |
                        // |  .   |  .   |  .   | Dim  |Bright|  .   ||  .   |  .   |  .   |  .   |  .   |  .   |
                        // |  .   |  .   |  .   |  .   |  .   |  .   ||  .   |  .   |Phase |  -   |  +   |  .   |
                        //                      |  .   |  .   |  .   ||  .   |  .   |  .   |
                        bindings = <
   &trans &rgb_fx 1 &rgb_fx 2 &rgb_fx 0 &rgb_ug RGB_TOG &key_rgb   &trans &trans &trans &pomodoro POMO_TOGGLE &pomodoro POMO_RESTART &trans
   &trans &trans &trans &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans     &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans          &trans           &trans     &trans &trans &pomodoro POMO_SELECT &pomodoro POMO_MINUS &pomodoro POMO_PLUS &trans
                        &trans          &trans           &trans     &trans &trans &trans
                        >;
                };
        };
};
