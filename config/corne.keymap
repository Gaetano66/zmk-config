#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <key_rgb.dtsi>

/* Per half: 6 underglow LEDs followed by 21 switch LEDs. */
&led_strip {
        chain-length = <27>;
};

/ {
        combos {
                compatible = "zmk,combos";

                combo_jlk_enter {
                        timeout-ms = <50>;
                        key-positions = <19 20 21>; /* J K L */
                        bindings = <&kp RET>;
                        layers = <0>;
                };
                combo_lk_backspace {
                        timeout-ms = <50>;
                        key-positions = <20 21>; /* K L */
                        bindings = <&kp BSPC>;
                        layers = <0>;
                };
                combo_sfd_escape {
                        timeout-ms = <50>;
                        key-positions = <14 15 16>; /* S D F */
                        bindings = <&kp ESC>;
                        layers = <0>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                lighting { if-layers = <1 2>; then-layer = <3>; };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        // Base
                        // |    Tab     |     Q      |     W      |     E      |     R      |     T      ||     Y      |     U      |     I      |     O      |     P      |    Bksp    |
                        // |    Ctrl    |     A      |     S      |     D      |     F      |     G      ||     H      |     J      |     K      |     L      |     ;      |     '      |
                        // |   Shift    |     Z      |     X      |     C      |     V      |     B      ||     N      |     M      |     ,      |     .      |     /      |    Esc     |
                        //                                        |    GUI     |   Lower    |   Enter    ||   Space    |   Raise    |    RAlt    |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp RET   &kp SPACE &mo 2 &kp RALT
                        >;
                };
                lower_layer {
                        // Lower (left middle thumb)   (. = transparent)
                        // |    Tab     |     1      |     2      |     3      |     4      |     5      ||     6      |     7      |     8      |     9      |     0      |    Del     |
                        // |  BT clear  |    BT 1    |    BT 2    |    BT 3    |    BT 4    |    BT 5    ||     .      |     .      |     Up     |     .      |     .      |     .      |
                        // |   Shift    |    Vol+    |    Vol-    | Play/Pause |    Next    |  Previous  ||     .      |    Left    |    Down    |   Right    |     .      |     .      |
                        //                                        |    GUI     |     .      |   Enter    ||   Space    |     .      |    RAlt    |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp DEL
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans   &trans   &kp UP   &trans          &trans &trans
   &kp LSHFT  &kp C_VOL_UP &kp C_VOL_DN &kp C_PP    &kp C_NEXT  &kp C_PREV     &trans   &kp LEFT &kp DOWN &kp RIGHT       &trans &trans
                                    &kp LGUI     &trans       &kp RET      &kp SPACE  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        // Raise (right middle thumb)   (. = transparent)
                        // |    Tab     |     !      |     @      |     #      |     $      |     %      ||     ^      |     &      |     *      |     (      |     )      |    Bksp    |
                        // |    Ctrl    |     .      |     .      |     .      |     .      |     .      ||     -      |     =      |     [      |     ]      |     \      |     `      |
                        // |   Shift    |     .      |     .      |     .      |     .      |     .      ||     _      |     +      |     {      |     }      |     |      |     ~      |
                        //                                        |    GUI     |     .      |   Enter    ||   Space    |     .      |    RAlt    |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp RET   &kp SPACE   &trans    &kp RALT
                        >;
                };

                lighting_layer {
                        // Lighting (hold Lower + Raise)   (. = transparent)
                        // |     .      |     .      |     .      |   Effect   |     .      |  Key LEDs  ||     .      |     .      |     .      |     .      |     .      |     .      |
                        // |     .      |     .      |     .      |   Dimmer   |  Brighter  |     .      ||     .      |     .      |     .      |     .      |     .      |     .      |
                        // |     .      |     .      |     .      |     .      |     .      |     .      ||     .      |     .      |     .      |     .      |     .      |     .      |
                        //                                        |     .      |     .      |     .      ||     .      |     .      |     .      |
                        bindings = <
   &trans &trans &trans &rgb_ug RGB_EFF &trans           &key_rgb   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans     &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans          &trans           &trans     &trans &trans &trans &trans &trans &trans
                        &trans          &trans           &trans     &trans &trans &trans
                        >;
                };
        };
};
